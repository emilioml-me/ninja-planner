{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*", "vite.config.ts", "vitest.config.ts", "client/vitest.config.ts", "tailwind.config.ts"],
  "exclude": ["node_modules", "dist"]
}
